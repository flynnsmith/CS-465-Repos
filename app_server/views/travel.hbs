<!DOCTYPE html>
<!-- Website template by freewebsitetemplates.com -->
<html>
<head>
	<meta charset="UTF-8">
	<title>Travel - Bhaccasyoniztas Beach Resort Website Template</title>
	<link rel="stylesheet" href="css/style.css" type="text/css">
</head>
<body>
	<div id="background">
		<div id="page">

			{{> header }}

			<div id="contents">
				<div class="box">
					<div>
						<div class="body">
							<h1>Travel</h1>
								{{#each trips}}
									<li>
										<a href="rooms.html"><img src="images/{{image}}" alt="Img"></a>
										<h2><a href="rooms.html">{{name}}</a></h2>
										<p>
											{{description}}
										</p>
									</li>
							{{/each}}
						</div>
					</div>
				</div>
			</div>

			{{> footer }}

		</div>
	</div>
</body>
</html>